PORT=3000

# MongoDB
MONGO_URL=mongodb://localhost:27018
MONGO_USERNAME=todo_admin
MONGO_PASSWORD=change_me
MONGO_DB_NAME=todos


# Master switch; the assistant is enabled only if this is not "false" AND the key is valid.
AI_ENABLED=true
AI_MAX_ITERATIONS=5

#GROQ
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_api_key
GROQ_MODEL=openai/gpt-oss-20b or any model youd like
GROQ_TIMEOUT_MS=30000
